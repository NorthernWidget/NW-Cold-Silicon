(kicad_wks (version 20220228) (generator pl_editor)
  (setup (textsize 1.5 1.5) (linewidth 0.15) (textlinewidth 0.15)
    (left_margin 10) (right_margin 10) (top_margin 10) (bottom_margin 10))
  (rect (comment "double border") (start 0 0 ltcorner) (end 0 0 rbcorner) (repeat 2) (incrx 2) (incry 2))
  (line (start 50 2 ltcorner) (end 50 0 ltcorner) (repeat 30) (incrx 50))
  (tbtext "1" (pos 25 1 ltcorner) (font (size 1.3 1.3)) (repeat 100) (incrx 50))
  (line (start 50 2 lbcorner) (end 50 0 lbcorner) (repeat 30) (incrx 50))
  (tbtext "1" (pos 25 1 lbcorner) (font (size 1.3 1.3)) (repeat 100) (incrx 50))
  (line (start 0 50 ltcorner) (end 2 50 ltcorner) (repeat 30) (incry 50))
  (tbtext "A" (pos 1 25 ltcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incry 50))
  (line (start 0 50 rtcorner) (end 2 50 rtcorner) (repeat 30) (incry 50))
  (tbtext "A" (pos 1 25 rtcorner) (font (size 1.3 1.3)) (justify center) (repeat 100) (incry 50))
  (rect (comment "title block, 101.6 x 35.56 mm as in FRAME_A_L") (start 103.6 37.56) (end 2 2))
  (line (comment "above Date/Sheet row") (start 103.6 7.08) (end 2 7.08))
  (line (comment "above license/REV row") (start 103.6 17.24) (end 2 17.24))
  (line (comment "above TITLE row") (start 103.6 24.86) (end 2 24.86))
  (line (comment "Date | Sheet") (start 32.48 7.08) (end 32.48 2))
  (line (comment "license | REV") (start 15.97 17.24) (end 15.97 7.08))
  (tbtext "Project:" (pos 101.06 33.75) (font (size 2.54 2.54)) (justify left))
  (tbtext "${PROJECT}" (pos 80.74 33.75) (font (size 2.54 2.54)) (justify left))
  (tbtext "Designer:" (pos 101.06 28.67) (font (size 2.54 2.54)) (justify left))
  (tbtext "${DESIGNER}" (pos 80.74 28.67) (font (size 2.54 2.54)) (justify left))
  (tbtext "TITLE:" (pos 102.33 22.32) (font (size 2.54 2.54)) (justify left))
  (tbtext "${SHEETNAME}" (pos 85.82 22.32) (font (size 2.54 2.54)) (justify left))
  (tbtext "This work is licensed under the Creative Commons Attribution-ShareAlike 4.0\nhttp://creativecommons.org/licenses/by-sa/4.0/" (pos 102.584 12.16) (font (size 1.778 1.778)) (justify left) (maxlen 85))
  (tbtext "REV:" (pos 14.7 14.7) (font (size 2.54 2.54)) (justify left))
  (tbtext "${REVISION}" (pos 14.7 10.89) (font (size 2.54 2.54)) (justify left))
  (tbtext "Date:" (pos 102.33 4.54) (font (size 2.54 2.54)) (justify left))
  (tbtext "${ISSUE_DATE}" (pos 90.9 4.54) (font (size 2.54 2.54)) (justify left))
  (tbtext "Sheet:" (pos 31.21 4.54) (font (size 2.54 2.54)) (justify left))
  (tbtext "${#}/${##}" (pos 17.24 4.54) (font (size 2.54 2.54)) (justify left))
)
